# Copy to .env.local and fill in. Never commit .env.local.

# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never expose these to the browser or paste them anywhere public.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: order confirmation emails (skipped when empty)
RESEND_API_KEY=
EMAIL_FROM=Next Ecom <onboarding@resend.dev>

# Tests only: point the Stripe SDK at the local fake server (e2e/fake-stripe.mjs)
# STRIPE_API_BASE=http://localhost:12111
